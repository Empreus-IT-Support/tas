# Resend — required for the enquiry and newsletter forms to send mail.
# Create a key at https://resend.com/api-keys
# Without it both forms return a 503 whose message tells the visitor to phone
# or email instead, so the site degrades rather than failing silently.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to the practice address in
# lib/site.ts, which brand guidelines §05 gives as tasc@arnfin.net.au.
CONTACT_TO_EMAIL=

# Sender. Must be on a Resend-verified domain. Note the practice mailbox is
# @arnfin.net.au, so the domain to verify in Resend may not be tascentre.com.au
# — check which one the client wants mail sent *from*. Leave blank to fall back
# to onboarding@resend.dev, which works out of the box but looks it.
CONTACT_FROM_EMAIL=

# Canonical origin for metadata, canonicals, sitemap and robots. Must match the
# domain actually served, including the www, or canonicals point at a host that
# does not answer. Leaving it unset lets Vercel's own domain be used, which
# also keeps the deploy out of search results until the real domain is attached
# (see app/robots.ts).
NEXT_PUBLIC_SITE_URL=https://www.tascentre.com.au
