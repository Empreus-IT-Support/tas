# Resend — required for the enquiry and newsletter forms to send mail.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to reception@tascentre.com.au.
CONTACT_TO_EMAIL=

# Sender. Must be a Resend-verified domain; until tascentre.com.au is verified,
# leave blank to fall back to onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Canonical URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://tascentre.com.au
