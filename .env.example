# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Contact form email → Atlas ---
# Atlas is Empreus's own platform. Mint the per-client key under
#   Clients > TASC > Documentation > API > Atlas
# The key is scoped to one sending domain plus a fixed recipient allowlist, so
# a leaked key can't mail anywhere else — anything outside that scope 403s.
ATLAS_API_KEY=

# Sender. Must be a BARE address Atlas authorises for this key — Atlas compares
# it exactly, so a "Name <addr>" form is rejected with a 403. The visitor's own
# address never goes here (it would fail DMARC); it goes in reply_to.
CONTACT_FROM_EMAIL=DoNotReply@tascentre.com.au

# Where enquiries are delivered. Must be on the key's allowlist in Atlas.
# Defaults to the practice address in lib/site.ts, which brand guidelines §05
# gives as tasc@arnfin.net.au.
CONTACT_TO_EMAIL=

# Override only if Atlas moves. Defaults to https://atlascontrol.io/api/email/send
# ATLAS_ENDPOINT=

# Note the practice mailbox is @arnfin.net.au, so the domain to verify in Atlas
# may not be tascentre.com.au — check which one the client wants mail sent
# *from*, since the key is scoped to a single sending domain.
#
# Without a key both forms return a 503 whose message tells the visitor to
# phone or email instead, so the site degrades rather than failing silently.

# Canonical origin for metadata, canonicals, sitemap and robots. Must match the
# domain actually served, including the www, or canonicals point at a host that
# does not answer. Leaving it unset lets Vercel's own domain be used, which
# also keeps the deploy out of search results until the real domain is attached
# (see app/robots.ts).
NEXT_PUBLIC_SITE_URL=https://www.tascentre.com.au
